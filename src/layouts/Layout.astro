---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Literary Broadside | Generator of Unimpeachable Excuses",
  description = "A bespoke generator of performative, editorial excuses set in fine typography for social evasions and indispensable pretexts."
} = Astro.props;

const today = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(new Date());
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FDFBF7" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Bodoni Moda & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#FDFBF7] text-[#1A1815] min-h-screen flex flex-col font-broadside-sans antialiased selection:bg-[#E8D3C4] selection:text-[#1A1815]">
    <!-- Top ornamental trim -->
    <header class="w-full max-w-4xl mx-auto pt-3 sm:pt-10 px-4 sm:px-8">
      <!-- Broadside Meta Bar (Hidden on mobile, visible on desktop) -->
      <div class="hidden sm:flex justify-between items-center text-xs tracking-[0.2em] uppercase text-[#645E56] pb-3 border-b border-[#E7E0D3]">
        <span class="font-medium">Vol. I &bull; No. 42</span>
        <span class="hidden md:inline italic font-broadside-serif lowercase tracking-normal text-[#8A6635] text-sm">an editorial instrument for social absolution</span>
        <time datetime={new Date().toISOString()} class="font-medium">{today}</time>
      </div>

      <!-- Masthead -->
      <div class="py-3 sm:py-8 text-center">
        <a href="/" class="group inline-block focus:outline-none">
          <p class="text-[9px] sm:text-xs font-semibold uppercase tracking-[0.25em] text-[#B84A28] mb-1 sm:mb-2 transition-colors">
            Gazette of Social Indispositions
          </p>
          <h1 class="font-broadside-serif text-3xl sm:text-5xl md:text-6xl tracking-tight text-[#1A1815] font-bold group-hover:text-[#B84A28] transition-colors leading-[1.1]">
            The Literary Broadside
          </h1>
          <p class="mt-1.5 sm:mt-3 text-xs sm:text-sm text-[#645E56] font-light max-w-lg mx-auto tracking-wide px-2">
            Composing unimpeachable pretexts, ornate regrets, and refined justifications since 1884.
          </p>
        </a>
      </div>

      <!-- Double hairline border (Hidden on mobile, visible on desktop) -->
      <div class="hidden sm:block border-t-[3px] border-b border-[#1A1815] py-1 text-center">
        <div class="border-t border-[#1A1815] py-1.5 flex justify-between items-center text-[10px] uppercase tracking-[0.25em] text-[#645E56] px-2">
          <span>Free Edition</span>
          <span>&bull; Set in Bodoni Moda &bull;</span>
          <span>One-Click Evasion</span>
        </div>
      </div>
    </header>

    <!-- Main Content Area with responsive padding -->
    <main class="flex-grow w-full max-w-4xl mx-auto px-4 sm:px-8 py-6 sm:py-12">
      <slot />
    </main>

    <!-- Colophon / Footer -->
    <footer class="w-full max-w-4xl mx-auto px-4 sm:px-8 pb-8 sm:pb-12 pt-6 mt-auto border-t border-[#E7E0D3]">
      <div class="flex flex-col sm:flex-row justify-between items-center text-center sm:text-left gap-3 text-xs text-[#645E56]">
        <div class="space-y-0.5">
          <p class="font-medium text-[#1A1815]">The Literary Broadside &mdash; Excuse Generator</p>
          <p class="text-[11px] text-[#9E978D]">Printed and bound digitally for the preservation of personal peace.</p>
        </div>
        <div class="text-center sm:text-right text-[10px] sm:text-[11px] tracking-widest uppercase text-[#8A6635]">
          <span>Edition 1.0 &bull; Netlify &amp; Astro</span>
        </div>
      </div>
    </footer>
  </body>
</html>
