---
import Layout from '../../layouts/Layout.astro';
import { getExcuse } from '../../lib/mockStore';

export const prerender = false;

const { id } = Astro.params;
const excuseRecord = id ? getExcuse(id) : null;
---

<Layout
  title={excuseRecord ? `Excuse No. ${id} | The Literary Broadside` : "Record Unaccounted For | The Literary Broadside"}
  description={excuseRecord ? `Official record of indisposition No. ${id} issued for ${excuseRecord.target}.` : "The requested excuse could not be retrieved from the archives."}
>
  <div class="max-w-2xl mx-auto space-y-8 sm:space-y-12">
    {excuseRecord ? (
      <>
        <!-- Header Note -->
        <div class="text-center space-y-1.5 sm:space-y-2">
          <span class="text-[9px] sm:text-xs font-semibold uppercase tracking-[0.2em] sm:tracking-[0.25em] text-[#8A6635]">
            Official Dispatch &bull; Record No. {id}
          </span>
          <h2 class="font-broadside-serif text-2xl sm:text-3xl text-[#1A1815]">
            Registered Declaration of Indisposition
          </h2>
        </div>

        <!-- The Broadside Card -->
        <div class="border border-[#E7E0D3] bg-[#FDFBF7] p-5 sm:p-12 relative shadow-none">
          <!-- Broadside corner ornaments -->
          <div class="absolute top-2 left-2 text-[10px] text-[#CEBEA4] select-none font-serif">&plus;</div>
          <div class="absolute top-2 right-2 text-[10px] text-[#CEBEA4] select-none font-serif">&plus;</div>
          <div class="absolute bottom-2 left-2 text-[10px] text-[#CEBEA4] select-none font-serif">&plus;</div>
          <div class="absolute bottom-2 right-2 text-[10px] text-[#CEBEA4] select-none font-serif">&plus;</div>

          <!-- Metadata Header -->
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center text-[10px] uppercase tracking-[0.16em] sm:tracking-[0.2em] text-[#8A6635] pb-4 sm:pb-6 border-b border-[#E7E0D3] gap-1.5">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <span>For: {excuseRecord.target}</span>
              <span>&bull;</span>
              <span>Regarding: {excuseRecord.scenario}</span>
              <span>&bull;</span>
              <span>Tone: {excuseRecord.tone}</span>
            </div>
            <time class="text-[#645E56]">{excuseRecord.dateIssued}</time>
          </div>

          <!-- Excuse Text -->
          <div class="py-8 sm:py-14 text-center">
            <blockquote class="font-broadside-serif text-xl sm:text-3xl md:text-4xl leading-[1.35] text-[#1A1815] italic font-normal tracking-tight px-1">
              &ldquo;{excuseRecord.excuse}&rdquo;
            </blockquote>

            <div class="mt-6 sm:mt-8 text-xs uppercase tracking-[0.18em] text-[#645E56]">
              <p>{excuseRecord.signOff}</p>
              <p class="font-medium text-[#1A1815] mt-1">The Management of My Own Discretion</p>
            </div>
          </div>

          <!-- Footer Details & Actions -->
          <div class="border-t border-[#E7E0D3] pt-4 sm:pt-6 flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-3">
            <div class="text-[11px] text-[#645E56] text-center sm:text-left">
              <span class="text-[#8A6635] uppercase tracking-wider font-semibold">Verification:</span> Authenticated Evasion
            </div>

            <button
              id="copy-excuse-btn"
              type="button"
              class="px-4 py-2.5 min-h-[44px] border border-[#E7E0D3] bg-[#FAF6ED] hover:bg-[#F4EFE4] active:bg-[#E8D3C4] text-[11px] font-semibold uppercase tracking-[0.15em] text-[#1A1815] transition-colors cursor-pointer text-center"
            >
              Copy Transcript
            </button>
          </div>
        </div>
      </>
    ) : (
      <div class="border border-[#E7E0D3] bg-[#FAF6ED] p-8 sm:p-14 text-center space-y-6">
        <span class="text-[10px] uppercase tracking-[0.25em] text-[#B84A28] font-semibold">
          Gazette Notice &bull; Folio Unaccounted For
        </span>
        <h2 class="font-broadside-serif text-2xl sm:text-4xl text-[#1A1815]">
          This Pretext Has Evaporated
        </h2>
        <p class="text-sm text-[#645E56] max-w-md mx-auto leading-relaxed">
          No dispatch marked <code class="font-mono text-xs bg-[#FDFBF7] px-2 py-1 border border-[#E7E0D3]">/e/{id}</code> exists in the archival vault. It may have expired or dissolved under scrutiny.
        </p>
      </div>
    )}

    <!-- Prominent "Generate Your Own" CTA Button (Per gemini.md guidelines) -->
    <div class="text-center pt-2">
      <a
        href="/"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 min-h-[48px] bg-[#B84A28] hover:bg-[#96391C] active:bg-[#802D13] text-[#FDFBF7] text-xs font-semibold uppercase tracking-[0.22em] transition-colors border border-[#96391C] shadow-sm cursor-pointer"
      >
        <span>Generate Your Own Excuse</span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <p class="mt-3 text-xs text-[#645E56] font-light">
        Preserve your peace. Produce a tailor-made pretext in seconds.
      </p>
    </div>

    <!-- Toast Notification (Fixed bottom on mobile) -->
    <div id="toast" class="fixed bottom-5 left-4 right-4 sm:left-auto sm:right-6 bg-[#1A1815] text-[#FDFBF7] text-xs px-4 py-3 border border-[#8A6635] text-center sm:text-left opacity-0 pointer-events-none transition-opacity duration-300 z-50">
      Copied to clipboard.
    </div>
  </div>

  <script>
    const copyBtn = document.getElementById('copy-excuse-btn');
    const toast = document.getElementById('toast');

    copyBtn?.addEventListener('click', () => {
      const quote = document.querySelector('blockquote')?.textContent?.replace(/[“”"]/g, '').trim();
      if (quote) {
        navigator.clipboard.writeText(quote);
        if (toast) {
          toast.classList.remove('opacity-0', 'pointer-events-none');
          toast.classList.add('opacity-100');
          setTimeout(() => {
            toast.classList.remove('opacity-100');
            toast.classList.add('opacity-0', 'pointer-events-none');
          }, 2500);
        }
      }
    });
  </script>
</Layout>
